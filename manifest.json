{
  "manifest_version": 3,
  "name": "Local Terminal In-Tab",
  "version": "1.0",
  "key": "",
  "description": "Membuka terminal lokal secara langsung di tab browser dengan Native Messaging Host otomatis.",
  "permissions": [
    "nativeMessaging",
    "clipboardRead",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
